LLM_API_KEY=your_virtual_key_starting_with_sk
LLM_MODEL=gemini-3.5-flash-lite
ENABLE_MOSS=true
ENABLE_LLM=true

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://frontend-orpin-chi-47.vercel.app
