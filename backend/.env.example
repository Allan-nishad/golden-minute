MOSS_PROJECT_ID=your_moss_project_id
MOSS_PROJECT_KEY=your_moss_project_key
MOSS_INDEX_NAME=golden-minute-emergency

# LLM Gateway Settings (Hackathon Gemini Gateway / OpenAI-compatible endpoint)
